{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    },
    {
      "source": "/index.html",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    }
  ],
  "cleanUrls": true
}
