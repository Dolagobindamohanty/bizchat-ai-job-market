# Reference only: the app does not automatically load this file.
# Set these in the backend process environment or hosting dashboard.
BIZCHAT_DATA_PATH=data/raw/jobs-india.csv
JOBMATCH_PROVIDER=openai
OPENAI_API_KEY=REPLACE_IN_PRIVATE_SERVER_ENVIRONMENT
JOBMATCH_EMBEDDING_MODEL=text-embedding-3-small
JOBMATCH_LLM_MODEL=gpt-4.1-mini
JOBMATCH_AI_DAILY_CALL_LIMIT=100
